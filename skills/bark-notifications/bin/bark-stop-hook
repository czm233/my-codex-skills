#!/usr/bin/env python3

"""Send one Bark notification for each completed Codex turn."""

from __future__ import annotations

import hashlib
import json
import os
import pathlib
import selectors
import subprocess
import sys
import time
from typing import Any


BARK_COMMAND = pathlib.Path(__file__).with_name("bark-task-complete")
EVENT_NAME = "turn_stopped"
DEFAULT_TITLE = "Codex"
CODEX_COMMAND = os.environ.get("CODEX_BARK_HOOK_CODEX_COMMAND", "codex")
# Keep metadata lookup bounded so it fits inside the 30-second user Hook budget.
THREAD_READ_TIMEOUT = 1.5
MAX_PROTOCOL_LINE_BYTES = 1_048_576
CODEX_HOME = pathlib.Path(
    os.environ.get("CODEX_HOME", pathlib.Path.home() / ".codex")
).expanduser()
DEFAULT_STATE_DIR = CODEX_HOME / "state" / "bark-stop-hook"


def emit(payload: dict[str, object]) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False))


def _current_thread_id() -> str | None:
    thread_id = os.environ.get("CODEX_THREAD_ID", "").strip()
    return thread_id or None


def _terminate_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return

    try:
        process.terminate()
        process.wait(timeout=1)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        try:
            process.kill()
            process.wait(timeout=1)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass


def _send_protocol_message(process: subprocess.Popen[bytes], payload: dict[str, Any]) -> bool:
    if process.stdin is None:
        return False

    try:
        process.stdin.write(json.dumps(payload, separators=(",", ":")).encode("utf-8") + b"\n")
        process.stdin.flush()
    except (BrokenPipeError, OSError, ValueError):
        return False
    return True


def _read_protocol_response(
    process: subprocess.Popen[bytes], response_id: int, timeout: float
) -> dict[str, Any] | None:
    if process.stdout is None:
        return None

    try:
        selector = selectors.DefaultSelector()
        try:
            selector.register(process.stdout, selectors.EVENT_READ)
            deadline = time.monotonic() + timeout
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return None

                ready = selector.select(remaining)
                if not ready:
                    return None

                line = process.stdout.readline()
                if not line:
                    return None
                if len(line) > MAX_PROTOCOL_LINE_BYTES:
                    continue

                try:
                    message = json.loads(line)
                except (json.JSONDecodeError, TypeError):
                    continue
                if isinstance(message, dict) and message.get("id") == response_id:
                    return message
        finally:
            selector.close()
    except (OSError, ValueError):
        return None


def _extract_thread_title(response: dict[str, Any]) -> str | None:
    if "error" in response:
        return None

    result = response.get("result")
    if not isinstance(result, dict):
        return None
    thread = result.get("thread")
    if not isinstance(thread, dict):
        return None

    title = thread.get("name")
    if not isinstance(title, str):
        return None
    title = " ".join(title.split())
    return title or None


def _read_thread_title(thread_id: str, cwd: object) -> str | None:
    """Read only thread metadata; never request turns or transcript items."""

    try:
        process = subprocess.Popen(
            [CODEX_COMMAND, "app-server", "--listen", "stdio://"],
            cwd=cwd if isinstance(cwd, str) and cwd else None,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        return None

    try:
        initialize = {
            "id": 1,
            "method": "initialize",
            "params": {
                "clientInfo": {"name": "bark-stop-hook", "version": "1.0"},
                "capabilities": {"experimentalApi": True},
            },
        }
        if not _send_protocol_message(process, initialize):
            return None
        if _read_protocol_response(process, 1, THREAD_READ_TIMEOUT) is None:
            return None
        if not _send_protocol_message(process, {"method": "initialized"}):
            return None

        thread_read = {
            "id": 2,
            "method": "thread/read",
            "params": {"threadId": thread_id, "includeTurns": False},
        }
        if not _send_protocol_message(process, thread_read):
            return None
        response = _read_protocol_response(process, 2, THREAD_READ_TIMEOUT)
        return _extract_thread_title(response) if response else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    finally:
        _terminate_process(process)


def _resolve_thread_title(event: dict[str, Any]) -> str:
    for field in ("thread_name", "threadName", "session_name", "sessionName"):
        value = event.get(field)
        if isinstance(value, str) and value.strip():
            return " ".join(value.split())

    thread_id = str(
        _current_thread_id()
        or event.get("thread_id")
        or event.get("threadId")
        or event.get("session_id")
        or ""
    )
    if not thread_id:
        return DEFAULT_TITLE

    return _read_thread_title(thread_id, event.get("cwd")) or DEFAULT_TITLE


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError, TypeError):
        emit({})
        return 0

    if not isinstance(event, dict) or event.get("hook_event_name") != "Stop":
        emit({})
        return 0

    # A continuation pass has already been requested for this stop event.
    if event.get("stop_hook_active"):
        emit({})
        return 0

    session_id = str(event.get("session_id") or "")
    turn_id = str(event.get("turn_id") or "")
    if not session_id or not turn_id:
        emit({})
        return 0

    # Codex Desktop can run ephemeral model turns for UI-only features such as
    # ambient suggestions. Those turns inherit the visible thread id through
    # CODEX_THREAD_ID but carry a different Stop-event session id. Ignore them
    # before creating dedupe state or invoking Bark. Preserve the previous
    # behavior on surfaces that do not provide CODEX_THREAD_ID.
    current_thread_id = _current_thread_id()
    if current_thread_id and session_id != current_thread_id:
        emit({})
        return 0

    dedupe_id = hashlib.sha256(f"{session_id}\0{turn_id}".encode()).hexdigest()
    state_dir = pathlib.Path(
        os.environ.get("CODEX_BARK_HOOK_STATE_DIR", str(DEFAULT_STATE_DIR))
    )
    try:
        state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        marker_path = state_dir / f"{dedupe_id}.sent"
        marker_fd = os.open(marker_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(marker_fd)
    except FileExistsError:
        emit({})
        return 0
    except OSError:
        emit({"systemMessage": "Bark task notification skipped (dedupe state unavailable)."})
        return 0

    title = _resolve_thread_title(event)
    command = [str(BARK_COMMAND), EVENT_NAME]
    if os.environ.get("CODEX_BARK_HOOK_DRY_RUN") == "1":
        command.append("--dry-run")

    try:
        result = subprocess.run(
            command,
            cwd=event.get("cwd") or None,
            input=title.encode("utf-8"),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=25,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        emit({"systemMessage": "Bark task notification failed (redacted)."})
        return 0

    if result.returncode != 0:
        emit({"systemMessage": "Bark task notification failed (redacted)."})
    else:
        emit({})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
