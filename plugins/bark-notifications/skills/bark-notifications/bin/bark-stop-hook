#!/usr/bin/env python3

"""Send one Bark notification for each completed Codex turn."""

from __future__ import annotations

import hashlib
import json
import os
import pathlib
import selectors
import shutil
import subprocess
import sys
import time
import unicodedata
from typing import Any


BARK_COMMAND = pathlib.Path(__file__).with_name("bark-task-complete")
EVENT_NAME = "turn_stopped"
DEFAULT_SESSION_TITLE = "本轮回复已结束"
CODEX_COMMAND = os.environ.get("CODEX_BARK_HOOK_CODEX_COMMAND", "codex")
# Metadata lookup must fit inside the 30-second plugin Hook budget.
THREAD_READ_TIMEOUT = 1.5
MAX_PROTOCOL_LINE_BYTES = 1_048_576
MAX_SESSION_TITLE_CHARS = 120
MAX_SESSION_TITLE_INPUT_CHARS = 4096
CODEX_HOME = pathlib.Path(
    os.environ.get("CODEX_HOME", pathlib.Path.home() / ".codex")
).expanduser()
DEFAULT_STATE_DIR = pathlib.Path(
    os.environ.get("PLUGIN_DATA", str(CODEX_HOME / "state"))
) / "bark-stop-hook"


def emit(payload: dict[str, object]) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False))


def _current_thread_id() -> str | None:
    thread_id = os.environ.get("CODEX_THREAD_ID", "").strip()
    return thread_id or None


def _terminate_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is None:
        try:
            process.terminate()
            process.wait(timeout=1)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            try:
                process.kill()
                process.wait(timeout=1)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass

    for stream in (process.stdin, process.stdout, process.stderr):
        if stream is None:
            continue
        try:
            stream.close()
        except (OSError, ValueError):
            pass


def _send_protocol_message(process: subprocess.Popen[bytes], payload: dict[str, Any]) -> bool:
    if process.stdin is None:
        return False

    try:
        process.stdin.write(json.dumps(payload, separators=(",", ":")).encode("utf-8") + b"\n")
        process.stdin.flush()
    except (BrokenPipeError, OSError, ValueError):
        return False
    return True


def _read_protocol_response(
    process: subprocess.Popen[bytes], response_id: int, timeout: float
) -> dict[str, Any] | None:
    if process.stdout is None:
        return None

    try:
        selector = selectors.DefaultSelector()
        try:
            selector.register(process.stdout, selectors.EVENT_READ)
            deadline = time.monotonic() + timeout
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return None

                ready = selector.select(remaining)
                if not ready:
                    return None

                line = process.stdout.readline()
                if not line:
                    return None
                if len(line) > MAX_PROTOCOL_LINE_BYTES:
                    continue

                try:
                    message = json.loads(line)
                except (json.JSONDecodeError, TypeError):
                    continue
                if isinstance(message, dict) and message.get("id") == response_id:
                    return message
        finally:
            selector.close()
    except (OSError, ValueError):
        return None


def _normalize_session_title(raw_title: object) -> str | None:
    if not isinstance(raw_title, str):
        return None

    safe_characters: list[str] = []
    for character in raw_title:
        if character in "\r\n\t" or unicodedata.category(character).startswith("C"):
            safe_characters.append(" ")
        else:
            safe_characters.append(character)

    normalized = " ".join("".join(safe_characters).split())
    if not normalized:
        return None
    return normalized[:MAX_SESSION_TITLE_CHARS]


def _extract_thread_title(response: dict[str, Any]) -> str | None:
    if "error" in response:
        return None

    result = response.get("result")
    if not isinstance(result, dict):
        return None
    thread = result.get("thread")
    if not isinstance(thread, dict):
        return None
    return _normalize_session_title(thread.get("name"))


def _codex_command() -> str:
    configured_command = os.environ.get("CODEX_BARK_HOOK_CODEX_COMMAND", "").strip()
    if configured_command:
        return configured_command

    discovered_command = shutil.which(CODEX_COMMAND)
    if discovered_command:
        return discovered_command

    # ChatGPT Desktop bundles the same CLI binary on macOS. The PATH lookup
    # remains first so other installations and non-macOS hosts are supported.
    desktop_command = "/Applications/ChatGPT.app/Contents/Resources/codex"
    if os.access(desktop_command, os.X_OK):
        return desktop_command
    return CODEX_COMMAND


def _read_thread_title(thread_id: str, cwd: object) -> str | None:
    """Read only Thread metadata; never request turns or transcript items."""

    try:
        process = subprocess.Popen(
            [_codex_command(), "app-server", "--listen", "stdio://"],
            cwd=cwd if isinstance(cwd, str) and cwd else None,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        return None

    try:
        initialize = {
            "id": 1,
            "method": "initialize",
            "params": {
                "clientInfo": {"name": "bark-stop-hook", "version": "1.0"},
                "capabilities": {"experimentalApi": True},
            },
        }
        if not _send_protocol_message(process, initialize):
            return None
        if _read_protocol_response(process, 1, THREAD_READ_TIMEOUT) is None:
            return None
        if not _send_protocol_message(process, {"method": "initialized"}):
            return None

        thread_read = {
            "id": 2,
            "method": "thread/read",
            "params": {"threadId": thread_id, "includeTurns": False},
        }
        if not _send_protocol_message(process, thread_read):
            return None
        response = _read_protocol_response(process, 2, THREAD_READ_TIMEOUT)
        return _extract_thread_title(response) if response else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    finally:
        _terminate_process(process)


def _transcript_turn_identity(transcript_path: str) -> str:
    """Derive a per-turn identity from transcript file metadata only.

    ZCode-style Stop events carry a transcript path instead of Codex's turn
    id. Each completed turn appends to the transcript, so path, mtime and
    size identify one turn without ever reading the file content.
    """

    if not transcript_path:
        return ""
    try:
        stat_result = os.stat(transcript_path)
    except OSError:
        return ""
    return f"{transcript_path}:{stat_result.st_mtime_ns}:{stat_result.st_size}"


def _resolve_session_title(event: dict[str, Any]) -> str:
    for field in ("thread_name", "threadName", "session_name", "sessionName"):
        title = _normalize_session_title(event.get(field))
        if title:
            return title

    thread_id = str(
        _current_thread_id()
        or event.get("thread_id")
        or event.get("threadId")
        or event.get("session_id")
        or ""
    )
    if not thread_id:
        return DEFAULT_SESSION_TITLE

    return _read_thread_title(thread_id, event.get("cwd")) or DEFAULT_SESSION_TITLE


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError, TypeError):
        emit({})
        return 0

    if not isinstance(event, dict):
        emit({})
        return 0

    # The Stop payload may omit hook_event_name on surfaces such as ZCode;
    # only reject an explicit mismatch.
    hook_event_name = event.get("hook_event_name")
    if hook_event_name is not None and hook_event_name != "Stop":
        emit({})
        return 0

    # A continuation pass has already been requested for this stop event.
    if event.get("stop_hook_active"):
        emit({})
        return 0

    session_id = str(event.get("session_id") or "")
    turn_id = str(event.get("turn_id") or "")
    transcript_path = str(event.get("transcript_path") or "")
    session_identity = session_id or _current_thread_id() or (
        f"transcript:{transcript_path}" if transcript_path else ""
    )
    if not session_identity:
        emit({})
        return 0

    turn_identity = turn_id or _transcript_turn_identity(transcript_path)
    if not turn_identity:
        # Last resort: dedupe only immediate double-fires of the same stop.
        turn_identity = f"t{int(time.time())}"

    # Codex Desktop can run ephemeral model turns for UI-only features such as
    # ambient suggestions. Those turns inherit the visible thread id through
    # CODEX_THREAD_ID but carry a different Stop-event session id. Ignore them
    # before creating dedupe state or invoking Bark. Preserve the previous
    # behavior on surfaces that do not provide CODEX_THREAD_ID.
    current_thread_id = _current_thread_id()
    if current_thread_id and session_id != current_thread_id:
        emit({})
        return 0

    dedupe_id = hashlib.sha256(
        f"{session_identity}\0{turn_identity}".encode()
    ).hexdigest()
    state_dir = pathlib.Path(
        os.environ.get("CODEX_BARK_HOOK_STATE_DIR", str(DEFAULT_STATE_DIR))
    )
    try:
        state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        marker_path = state_dir / f"{dedupe_id}.sent"
        marker_fd = os.open(marker_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(marker_fd)
    except FileExistsError:
        emit({})
        return 0
    except OSError:
        emit({"systemMessage": "Bark task notification skipped (dedupe state unavailable)."})
        return 0

    session_title = _resolve_session_title(event)
    command = [str(BARK_COMMAND), EVENT_NAME]
    if os.environ.get("CODEX_BARK_HOOK_DRY_RUN") == "1":
        command.append("--dry-run")

    try:
        result = subprocess.run(
            command,
            cwd=event.get("cwd") or None,
            input=session_title.encode("utf-8"),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=25,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        emit({"systemMessage": "Bark task notification failed (redacted)."})
        return 0

    if result.returncode != 0:
        emit({"systemMessage": "Bark task notification failed (redacted)."})
    else:
        emit({})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
