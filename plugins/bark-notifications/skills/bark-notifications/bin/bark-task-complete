#!/usr/bin/env python3

"""Send a whitelisted Codex turn status to Bark without exposing credentials."""

from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys
import unicodedata


BARK_KEYCHAIN_SERVICE = "codex-bark-notifications"
BARK_KEYCHAIN_ACCOUNT = "codex"
BARK_ENDPOINT = "https://api.day.app/push"
BARK_GROUP_PREFIX = "codex-task-status"
DEFAULT_MACHINE_LABEL = "Mac"
MACHINE_CONFIG_FILENAME = "bark-notifications.json"
MACHINE_LABEL_ENV = "CODEX_BARK_MACHINE_LABEL"
MAX_MACHINE_LABEL_CHARS = 24
DEFAULT_SESSION_TITLE = "本轮回复已结束"
MAX_SESSION_TITLE_CHARS = 120
MAX_SESSION_TITLE_INPUT_CHARS = 4096
EVENT_BODIES = {
    "turn_stopped": "本轮回复已结束",
}


def emit(message: str) -> None:
    sys.stdout.write(message + "\n")


def _codex_home() -> pathlib.Path:
    configured_home = os.environ.get("CODEX_HOME")
    if configured_home:
        return pathlib.Path(configured_home).expanduser()
    return pathlib.Path.home() / ".codex"


def normalize_machine_label(raw_label: object) -> str | None:
    if not isinstance(raw_label, str):
        return None

    safe_characters: list[str] = []
    for character in raw_label:
        if character in "\r\n\t" or unicodedata.category(character).startswith("C"):
            safe_characters.append(" ")
        else:
            safe_characters.append(character)

    normalized = " ".join("".join(safe_characters).split())
    if not normalized:
        return None
    return normalized.replace("[", "(").replace("]", ")")[:MAX_MACHINE_LABEL_CHARS]


def normalize_session_title(raw_title: object) -> str:
    if not isinstance(raw_title, str):
        return DEFAULT_SESSION_TITLE

    safe_characters: list[str] = []
    for character in raw_title:
        if character in "\r\n\t" or unicodedata.category(character).startswith("C"):
            safe_characters.append(" ")
        else:
            safe_characters.append(character)

    normalized = " ".join("".join(safe_characters).split())
    return normalized[:MAX_SESSION_TITLE_CHARS] or DEFAULT_SESSION_TITLE


def normalize_reply_preview(raw: object) -> str:
    if not isinstance(raw, str):
        return ""
    safe = "".join(" " if unicodedata.category(c).startswith("C") else c for c in raw)
    text = " ".join(safe.split()).strip()
    return text[:30] + ("…" if len(text) > 30 else "")


def _read_configured_machine_label() -> str | None:
    config_path = _codex_home() / MACHINE_CONFIG_FILENAME
    try:
        with config_path.open("r", encoding="utf-8") as config_file:
            config = json.load(config_file)
    except (OSError, ValueError, TypeError):
        return None

    if not isinstance(config, dict):
        return None
    return normalize_machine_label(config.get("machine_label"))


def resolve_sound() -> str:
    """Use a local ringtone name, retaining bell for absent or invalid config."""
    config_path = _codex_home() / MACHINE_CONFIG_FILENAME
    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return "bell"
    sound = config.get("sound") if isinstance(config, dict) else None
    if (
        not isinstance(sound, str)
        or not sound.strip()
        or len(sound) > 120
        or any(unicodedata.category(char).startswith("C") or char in "/\\" for char in sound)
    ):
        return "bell"
    return sound.strip()


def _read_command_text(command: list[str]) -> str | None:
    try:
        result = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None

    if result.returncode != 0 or not result.stdout:
        return None
    return result.stdout.decode("utf-8", errors="replace").strip()


def _read_macos_machine_label() -> str | None:
    computer_name = _read_command_text(["/usr/sbin/scutil", "--get", "ComputerName"])
    if computer_name:
        return normalize_machine_label(computer_name)

    host_name = _read_command_text(["/bin/hostname", "-s"])
    return normalize_machine_label(host_name)


def resolve_machine_label() -> str:
    environment_label = normalize_machine_label(os.environ.get(MACHINE_LABEL_ENV))
    if environment_label:
        return environment_label

    configured_label = _read_configured_machine_label()
    if configured_label:
        return configured_label

    detected_label = _read_macos_machine_label()
    if detected_label:
        return detected_label

    return DEFAULT_MACHINE_LABEL


def parse_arguments() -> tuple[str, bool] | None:
    dry_run = False
    event_names: list[str] = []

    for argument in sys.argv[1:]:
        if argument == "--dry-run" and not dry_run:
            dry_run = True
        else:
            event_names.append(argument)

    if len(event_names) != 1 or event_names[0] not in EVENT_BODIES:
        return None
    return event_names[0], dry_run


def format_notification_group(machine_label: str) -> str:
    return f"{BARK_GROUP_PREFIX}:{machine_label}"[:64]


def main() -> int:
    parsed_arguments = parse_arguments()
    if parsed_arguments is None:
        emit("status=error category=unsupported-arguments")
        return 64

    event_name, dry_run = parsed_arguments
    machine_label = resolve_machine_label()
    raw_input = sys.stdin.read(MAX_SESSION_TITLE_INPUT_CHARS)
    try:
        notification = json.loads(raw_input)
    except (ValueError, TypeError):
        notification = None
    if isinstance(notification, dict):
        session_title = normalize_session_title(notification.get("session_title"))
        title = f"{session_title} · {machine_label}"
        body = normalize_reply_preview(notification.get("reply_preview"))
        if not body:
            emit("status=skipped category=missing-reply-preview")
            return 0
    else:
        # Preserve compatibility for explicit legacy standalone calls.
        title = machine_label
        body = normalize_session_title(raw_input)

    if dry_run:
        emit(f"status=dry-run event={event_name} sent=false")
        return 0

    try:
        credential_result = subprocess.run(
            [
                "/usr/bin/security",
                "find-generic-password",
                "-a",
                BARK_KEYCHAIN_ACCOUNT,
                "-s",
                BARK_KEYCHAIN_SERVICE,
                "-w",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        emit("status=error category=credential-unavailable")
        return 2

    device_key_bytes = credential_result.stdout.strip()
    if credential_result.returncode != 0 or not device_key_bytes:
        emit("status=error category=credential-unavailable")
        return 2

    try:
        device_key = device_key_bytes.decode("utf-8")
    except UnicodeDecodeError:
        emit("status=error category=credential-unavailable")
        return 2

    payload = json.dumps(
        {
            "device_key": device_key,
            "title": title,
            "body": body,
            "level": "active",
            "sound": resolve_sound(),
            "group": format_notification_group(machine_label),
        },
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    del device_key, device_key_bytes

    try:
        bark_result = subprocess.run(
            [
                "/usr/bin/curl",
                "--fail",
                "--silent",
                "--connect-timeout",
                "8",
                "--max-time",
                "20",
                "--output",
                "/dev/null",
                "--write-out",
                "status=%{http_code} total=%{time_total}s",
                "--request",
                "POST",
                BARK_ENDPOINT,
                "--header",
                "Content-Type: application/json; charset=utf-8",
                "--data-binary",
                "@-",
            ],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=25,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        emit("status=error category=request-failed")
        return 3

    if bark_result.returncode != 0:
        emit(f"status=error category=request-failed curl_exit={bark_result.returncode}")
        return 3

    emit(bark_result.stdout.decode("utf-8", errors="replace"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
